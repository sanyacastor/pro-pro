---
import BaseLayout from "../layouts/BaseLayout.astro";
import MapPage from "../components/mapPage/MapPage.tsx";
import { buildGeoJSON, ogForTag } from "../lib/mapData";

const pointsByTypeGeoJSON = buildGeoJSON();
const og = ogForTag(null);
---
<BaseLayout
  title={og.title}
  description={og.description}
  ogUrl={og.ogUrl}
  ogImage={og.ogImage}
  headerOnly={true}
>
  <MapPage client:only="react" pointsByTypeGeoJSON={pointsByTypeGeoJSON} />
</BaseLayout>

<script>
  // Inject the Mapbox token at runtime so the static build doesn't ship it.
  const TOKEN = (window as any).__MAPBOX_TOKEN__ || import.meta.env.PUBLIC_MAPBOX_TOKEN || "";
  (window as any).__MAPBOX_TOKEN__ = TOKEN;
</script>
