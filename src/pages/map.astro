---
import BaseLayout from "../layouts/BaseLayout.astro";
import MapPage from "../components/mapPage/MapPage.tsx";
import { buildGeoJSON, ogForTag } from "../lib/mapData";

const pointsByTypeGeoJSON = buildGeoJSON();
const og = ogForTag(null);
---
<BaseLayout
  title={og.title}
  description={og.description}
  ogUrl={og.ogUrl}
  ogImage={og.ogImage}
  headerOnly={true}
>
  <MapPage client:load pointsByTypeGeoJSON={pointsByTypeGeoJSON} />
</BaseLayout>
