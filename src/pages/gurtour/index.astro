---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const reviews = await getCollection("gurtour");
const publicReviews = reviews.filter((r) => !r.id.startsWith("____"));
---
<BaseLayout
  title="Про про | Гур тур"
  description="Авторски блог о еде в Протвино и окресностях"
  ogUrl="https://pro-pro.ru/gurtour"
  headerOnly={true}
  headerMode="gurtour"
>
  <div class="gt">
    <div class="gt__container">
      <div class="gt__logo">
        <img src="/images/gurtour/gur_tour_logo.svg" alt="Gur tour logo" />
      </div>
      <ul class="gt__list">
        {publicReviews.map((r) => (
          <li class="gt__link"><a href={`/gurtour/${r.id}`}>{r.data.title}</a></li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .gt {
    width: 100vw;
    height: 100vh;
    height: 100svh;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url('/images/content/gur_tour_background.webp');
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
  }
  .gt__container {
    position: relative;
    height: 100vh;
    height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 16px;
  }
  .gt__logo {
    width: 500px;
    max-width: 100%;
  }
  .gt__logo img {
    width: 100%;
    max-width: 100%;
    height: auto;
  }
  .gt__list {
    position: absolute;
    width: 100%;
    height: 100%;
    list-style: none;
    color: #fff282;
    text-align: center;
    font-family: "Piazzolla";
    font-size: 48px;
    font-style: normal;
    font-weight: 500;
    line-height: 134.5%;
    text-transform: uppercase;
  }
  .gt__link {
    position: absolute;
    box-shadow: 0px 0px 14px 3px rgba(0, 0, 0, 0.28);
    font-family: "Lack";
    font-size: 30px;
    padding: 20px 50px;
    border-radius: 50%;
    line-height: 88.5%;
    background: #ffc229;
    color: #ec500e;
    transition: transform 150ms ease-in-out;
  }
  .gt__link:nth-child(1) {
    top: 340px;
    right: 30px;
    transform: rotate(12deg);
  }
  .gt__link:nth-child(2) {
    top: 140px;
    left: 120px;
    transform: rotate(-12deg);
  }
  .gt__link:nth-child(3) {
    top: 510px;
    left: 120px;
    transform: rotate(-6deg);
  }
  .gt__link:hover { transform: scale(1.1) rotate(0); }
  @media (max-width: 780px) {
    .gt__logo { max-width: 230px; }
    .gt__link:nth-child(1) { top: auto; bottom: 80px; right: 20px; }
    .gt__link:nth-child(2) { bottom: auto; top: 120px; left: 16px; }
    .gt__link:nth-child(3) { top: auto; bottom: 220px; left: 16px; }
  }
</style>
