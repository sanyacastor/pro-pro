    font-family: "Piazzolla";
    font-weight: 300;
    font-size: 48px;
    line-height: 100%;
    margin: 0;
    margin-bottom: 32px;
  }

  /* ArticleContainer */
  .article-container {
    margin-top: 32px;
    margin-bottom: 100px;
  }

  /* Container */
  .container {
    width: 760px;
    margin: 0 auto;
    font-size: 18px;
    position: relative;
  }

  /* Intro */
  .article-intro {
    font-family: "Piazzolla";
    font-style: italic;
    font-weight: 300;
    font-size: 20px;
    line-height: 130%;
    padding: 0;
    margin: 0;
    max-width: 760px;
  }

  /* Paragraph (default) */
  .article-paragraph {
    position: relative;
    font-family: "Piazzolla";
    font-style: normal;
    font-weight: 400;
    line-height: 130%;
    font-size: 20px;
    padding: 0;
    margin: 0;
    max-width: 760px;
    z-index: 11;
  }

  .article-paragraph + .article-paragraph {
    margin-top: 32px;
  }

  /* SubSection */
  .sub-section {
    margin-top: 32px;
  }

  /* ArticleSubtitle (within sub-section - replaces styled.p ArticleSubtitle) */
