---
import { HERO } from "../config";
---
<a href={HERO.link} class="announcement" style={`background-image: url(${HERO.image});`}>
  <div class="announcement__container">
    <div class="announcement__header">
      <h1 class="announcement__title" set:html={HERO.title}></h1>
      <div class="announcement__author">Автор: {HERO.author}</div>
    </div>
  </div>
</a>

<style>
  .announcement {
    width: 100%;
    height: 100vh;
    background-position: 50% 50%;
    background-repeat: no-repeat;
    background-size: cover;
    display: flex;
    align-items: flex-end;
    cursor: pointer;
  }
  .announcement__container {
    max-width: 1400px;
    margin: 0 auto;
  }
  .announcement__header {
    width: 100%;
    display: block;
    color: #fff;
    padding-bottom: 42px;
  }
  .announcement__title {
    font-family: "Base&Bloom";
    font-size: 90px;
    font-weight: 400;
    line-height: 74px;
    text-align: center;
    margin: 0;
    width: 100%;
    color: #fff;
  }
  .announcement__author {
    font-family: "Lack";
    font-style: normal;
    font-weight: 300;
    font-size: 12px;
    line-height: 134%;
    text-align: center;
    margin-top: 18px;
    text-transform: uppercase;
  }
  @media (max-width: 1160px) {
    .announcement {
      background-position: 50% 50%;
      background-repeat: no-repeat;
      background-size: cover;
    }
    .announcement__container {
      width: 100%;
      padding: 0 28px;
    }
    .announcement__title {
      font-size: 48px;
      line-height: 89%;
    }
    .announcement__author {
      font-size: 12px;
      line-height: 89%;
    }
  }
</style>
