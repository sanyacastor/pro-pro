---
type Article = {
  url: string;
  title: string;
  author?: string;
  thumbnail: string;
};

type Props = { items?: Article[] };

const { items = [] } = Astro.props;
---
<section class="articles-row">
  <div class="articles-row__inner">
    {items.map((a) => (
      <a class="articles-row__item" href={a.url}>
        <div class="articles-row__image">
          <img src={a.thumbnail} alt={a.title} loading="lazy" />
        </div>
        <h2 class="articles-row__title" set:html={a.title}></h2>
        {a.author && <span class="articles-row__author">АВТОР: {a.author}</span>}
      </a>
    ))}
  </div>
</section>

<style>
  .articles-row {
    padding: 0;
    margin: 104px 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .articles-row__inner {
    width: 1160px;
    margin: 0 auto;
    padding: 0 8px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }
  .articles-row__item {
    max-width: 500px;
  }
  .articles-row__item img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .articles-row__title {
    font-family: "Base&Bloom";
    font-style: normal;
    font-weight: 400;
    font-size: 46px;
    line-height: 90%;
    color: #171f2e;
    margin-top: 16px;
    margin-bottom: 0;
  }
  .articles-row__author {
    display: block;
    font-family: "Lack";
    font-style: normal;
    font-weight: 400;
    font-size: 12px;
    line-height: 134.5%;
    text-transform: uppercase;
    margin-top: 8px;
    margin-bottom: 0;
  }
  @media (max-width: 1160px) {
    .articles-row__inner {
      width: 100%;
      min-width: 320px;
    }
  }
  @media (max-width: 1060px) {
    .articles-row {
      margin-top: 0;
      margin-bottom: 0;
    }
    .articles-row__inner {
      padding: 32px 0;
      flex-direction: column;
      margin: 0 auto;
    }
    .articles-row__item {
      max-width: 100%;
      margin-top: 40px;
    }
    .articles-row__item img {
      max-width: 100%;
    }
    .articles-row__title {
      font-size: 32px;
      font-style: normal;
      font-weight: 400;
      line-height: 90%;
      text-transform: uppercase;
    }
  }
</style>
