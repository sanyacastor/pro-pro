---
import { Image } from "astro:assets";
---
<a href="/article/istorii-vybora" class="single-promo">
  <div class="single-promo__inner">
    <div class="single-promo__image">
      <Image
        src="/images/posts/preview_selection_history.jpg"
        alt="Истории выбора"
        width={600}
        height={480}
      />
    </div>
    <div class="single-promo__description">
      <h3 class="single-promo__title">истории выбора:</h3>
      <p class="single-promo__text">
        как молодые девушки принимали решение переехать в&nbsp;маленький городок
        в&nbsp;лесу
      </p>
      <div class="single-promo__author">Автор: Аня Медведкова</div>
    </div>
  </div>
</a>

<style>
  .single-promo {
    width: 100%;
    display: flex;
    margin-top: 104px;
    margin-bottom: 104px;
  }
  .single-promo__inner {
    background: #d8cbff;
    margin: 0 auto;
    width: 100%;
    max-width: 1160px;
    display: flex;
    flex-direction: row;
    gap: 60px;
  }
  .single-promo__image :global(img) {
    height: auto;
  }
  .single-promo__title {
    font-family: "Base&Bloom";
    font-style: normal;
    font-weight: 400;
    font-size: 46px;
    line-height: 90%;
    text-transform: uppercase;
    margin-top: 48px;
    margin-bottom: 0;
    max-width: 380px;
    color: #171f2e;
  }
  .single-promo__text {
    font-family: "Piazzolla";
    font-style: italic;
    font-weight: 300;
    font-size: 32px;
    line-height: 105%;
    margin-top: 8px;
    position: relative;
    max-width: 380px;
  }
  .single-promo__text::before {
    content: "";
    position: absolute;
    left: -33px;
    width: 380px;
    height: 184px;
    background-image: url("/images/icons/preview_selection_icon.svg");
    background-repeat: no-repeat;
    background-size: cover;
  }
  .single-promo__author {
    font-family: "Lack";
    font-style: normal;
    font-weight: 300;
    font-size: 28px;
    line-height: 134%;
    text-align: left;
    margin-top: 18px;
    text-transform: uppercase;
  }

  @media (max-width: 960px) {
    .single-promo {
      padding: 0 8px;
      margin-top: 45px;
      margin-bottom: 26px;
      overflow: hidden;
    }
    .single-promo__inner {
      flex-direction: column;
      padding: 0 8px;
      gap: 0;
      background: #f8f3f3;
    }
    .single-promo__image :global(img) {
      width: 100%;
    }
    .single-promo__description {
      padding: 0 26px;
      padding-bottom: 43px;
      background: #d8cbff;
      max-width: 100%;
      padding-top: 32px;
    }
    .single-promo__title {
      margin-top: 0;
      font-size: 32px;
    }
    .single-promo__text {
      font-size: 28px;
    }
    .single-promo__text::before {
      display: none;
      width: 305px;
      height: 148px;
    }
    .single-promo__author {
      font-size: 12px;
    }
  }
</style>
